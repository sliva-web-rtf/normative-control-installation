IMAGE_TAG=v1.0.0
HOST_URL=https://normocontrol.example.ru
APP_BIND=127.0.0.1
APP_PORT=8080
DOCUMENT_CHECK_WORKERS=1

OIDC_ISSUER_URI=https://idp.example.ru/realms/example
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email
OIDC_ADMIN_EMAILS=admin@example.ru,ivanov@example.ru

#   JWT_SECRET:        openssl rand -base64 48
JWT_SECRET=

POSTGRES_URL=jdbc:postgresql://postgres:5432/normative-control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=normocontrol
RABBITMQ_PASSWORD=
RABBITMQ_REQUEST_QUEUE=document.request
RABBITMQ_RESULT_QUEUE=document.result

S3_URL=http://minio:9000
S3_ENDPOINT=minio:9000
S3_SECURE=false
S3_REGION=us-east-1
S3_BUCKET=normocontrol
S3_ACCESS_KEY=normocontrol
S3_SECRET_KEY=
